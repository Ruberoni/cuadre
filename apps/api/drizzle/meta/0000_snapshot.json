        "products_sku_format": {
          "name": "products_sku_format",
          "value": "\"catalog\".\"products\".\"sku\" ~ '^[A-Z0-9-]{1,20}$'"
        },
        "products_name_length": {
          "name": "products_name_length",
          "value": "char_length(\"catalog\".\"products\".\"name\") between 1 and 120"
        },
        "products_unit_of_measure": {
          "name": "products_unit_of_measure",
          "value": "\"catalog\".\"products\".\"unit_of_measure\" in ('UNIT', 'BOX', 'BULK', 'KILOGRAM', 'LITER')"
        },
        "products_tax_rate": {
