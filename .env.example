# Optional: every value below is already the default when no .env exists.
# POSTGRES_PORT is read by docker compose; 5432 is often taken by a local Postgres.
POSTGRES_PORT=5433
# Database URLs default to cuadre / cuadre_test / cuadre_e2e on POSTGRES_PORT, and to
# cuadre_wt_<worktree>__dev|__test|__e2e in a git worktree (packages/dev-env). Setting them here
# turns that per-worktree default off.
# DATABASE_URL=postgres://cuadre:cuadre@localhost:5433/cuadre
# DATABASE_URL_TEST=postgres://cuadre:cuadre@localhost:5433/cuadre_test
API_PORT=3000
# Sessions (Better Auth). The secret has a dev-only default; production must set its own (>= 32 chars).
# BETTER_AUTH_SECRET=
# Origin the browser loads the app from (the web dev server, which proxies /api).
BETTER_AUTH_URL=http://localhost:5173
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4173
# Seeded users (`pnpm db:seed`), test values only: admin@cuadre.test, ventas@cuadre.test,
# compras@cuadre.test, almacen@cuadre.test, all with the password cuadre-demo-2026.
