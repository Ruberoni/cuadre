{
  "name": "cuadre",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "biome check . && pnpm lint:boundaries",
    "lint:boundaries": "depcruise apps/api/src",
    "format": "biome check --write .",
    "db:migrate": "pnpm --filter @cuadre/api db:migrate",
    "db:seed": "pnpm --filter @cuadre/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "fast-check": "4.10.2",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
