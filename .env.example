# Optional: every value below is already the default when no .env exists.
# POSTGRES_PORT is read by docker compose; 5432 is often taken by a local Postgres.
POSTGRES_PORT=5433
DATABASE_URL=postgres://cuadre:cuadre@localhost:5433/cuadre
DATABASE_URL_TEST=postgres://cuadre:cuadre@localhost:5433/cuadre_test
API_PORT=3000
