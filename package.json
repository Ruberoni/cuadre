{
  "name": "cuadre",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "turbo run test:unit test:integration && pnpm test:hooks",
    "test:unit": "turbo run test:unit && pnpm test:hooks",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "biome check . && pnpm lint:boundaries",
    "lint:boundaries": "depcruise apps/api/src apps/web/src packages/shared-kernel/src",
    "format": "biome check --write .",
    "verify": "node scripts/verify.mts",
    "db:migrate": "pnpm --filter @cuadre/api db:migrate",
    "db:seed": "pnpm --filter @cuadre/api db:seed",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "fast-check": "4.10.2",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
