{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.depcruise.json",
    ".dependency-cruiser.cjs",
    "biome.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL*", "API_PORT", "API_URL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:unit": {
      "dependsOn": ["^test:unit"],
      "env": ["CI", "FC_SEED", "FC_PATH"]
    },
    "test:integration": {
      "cache": false,
      "env": ["CI", "FC_SEED", "FC_PATH", "DATABASE_URL*"]
    },
    "test:e2e": {
      "cache": false,
      "env": ["CI", "PLAYWRIGHT_CHANNEL", "DATABASE_URL_E2E", "E2E_API_PORT", "E2E_WEB_PORT"]
    }
  }
}
