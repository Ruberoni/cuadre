          "name": "products_sale_price_positive",
          "value": "\"catalog\".\"products\".\"sale_price_minor\" > 0"
        },
        "products_sale_price_usd": {
          "name": "products_sale_price_usd",
          "value": "\"catalog\".\"products\".\"sale_price_currency\" = 'USD'"
